# Copy to .env and fill in. .env is gitignored.
# D-5: OpenAI-compatible provider, configurable via base URL.
#   OpenRouter example:
#     NEXUSOPS_LLM_API_KEY=<openrouter key>
#     NEXUSOPS_LLM_API_URL=https://openrouter.ai/api/v1
#     NEXUSOPS_SLM_MODEL=openrouter/auto
#     NEXUSOPS_FRONTIER_MODEL=anthropic/claude-sonnet-4
#   TokenRouter example:
#     NEXUSOPS_LLM_API_KEY=<tokenrouter key>
#     NEXUSOPS_LLM_API_URL=https://api.tokenrouter.com/v1
#     NEXUSOPS_SLM_MODEL=z-ai/glm-5.3-free
NEXUSOPS_LLM_API_KEY=
NEXUSOPS_LLM_API_URL=https://openrouter.ai/api/v1
NEXUSOPS_SLM_MODEL=openrouter/auto
NEXUSOPS_FRONTIER_MODEL=anthropic/claude-sonnet-4
NEXUSOPS_REDIS_URL=redis://localhost:6379/0